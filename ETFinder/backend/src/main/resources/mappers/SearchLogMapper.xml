<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.etfinder.mvc.ranking.mapper.SearchLogMapper">

    <!-- 1. 사용자별 검색 로그 저장 -->
    <insert id="insertSearchLog" parameterType="SearchLog">
        INSERT INTO search_log(user_id, keyword, created_at)
        VALUES (#{userId}, #{keyword}, NOW())
    </insert>

    <!-- 2. 사용자별 검색 로그 조회 -->
    <select id="selectSearchLogByUser" resultType="SearchLog">
        SELECT *
        FROM search_log
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

    <!-- 3. 사용자별 특정 로그 삭제 -->
    <delete id="deleteSearchLogById">
        DELETE FROM search_log
        WHERE user_id = #{userId} AND search_log_id = #{searchLogId}
    </delete>

    <!-- 4. 사용자별 검색 로그 전체 삭제 -->
    <delete id="deleteAllSearchLog">
        DELETE FROM search_log
        WHERE user_id = #{userId}
    </delete>

</mapper>
