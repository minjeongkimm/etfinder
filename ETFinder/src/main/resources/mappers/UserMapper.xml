<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.etfinder.mvc.user.mapper.UserMapper">

	<insert id="insertUser" parameterType="User">
	    INSERT INTO users (nickname, provider, provider_id, created_at)
	    VALUES (#{nickname}, #{provider}, #{providerId}, NOW())
	</insert>

	<select id="findByProviderId" resultType="User">
	    SELECT * FROM users WHERE provider_id = #{providerId}
	</select>
	
	<update id="updateUser" parameterType="User">
		UPDATE users
		<set>
	        <if test="request.nickname != null and request.nickname != ''">
	            nickname = #{request.nickname},
	        </if>
	        <if test="request.email != null and request.email != ''">
	            email = #{request.email},
	        </if>
	        <if test="request.age != null">
	            age = #{request.age},
	        </if>
	        <if test="request.propensity != null">
	        	propensity = #{request.propensity},
	        </if>
	    </set>
	    WHERE provider_id = #{providerId}
	</update>
	
	<delete id="deleteUser">
		DELETE FROM users
		WHERE provider_id = #{providerId}
	</delete>

</mapper>
